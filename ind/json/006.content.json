[
{
"content_id": "ind-t54-v1",
"reference_id": 0,
"version": "1.0.4",
"title": "Gabriel",
"media_type": "Text",
"index_reference": "gabriel",
"language": "ind",
"review_level": "None",
"content": "<p><b>Gabriel</b> adalah nama seorang malaikat agung. Ini adalah <a href=\"#t4\">malaikat</a> dengan <a href=\"#t8\">kuasa</a> khusus. Alkitab menyebutkan dua malaikat agung dengan nama: Gabriel dan Mikhael. Dalam Perjanjian Lama, Gabriel menjelaskan kepada Daniel makna penglihatan-<b>penglihatan</b> Daniel. Dalam Perjanjian Baru, Gabriel menampakkan diri kepada Zakharia untuk mengatakan kepadanya bahwa istrinya akan melahirkan seorang anak laki-laki meskipun ia sudah tua. Anak ini adalah <b>Yohanes pembaptis</b>. Tidak lama setelah ini, Gabriel menampakkan diri kepada perawan <a href=\"#t89\">Maria</a> dan mengatakan kepadanya bahwa ia akan mengandung dengan kuasa Allah. Anak laki-laki yang akan dilahirkannya akan menjadi raja untuk selamanya, dan Ia adalah <a href=\"#t129\">Anak Allah</a>. </p>",
