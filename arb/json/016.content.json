{
"content_id": "arb-t84-v1",
"reference_id": 0,
"version": "1.0.4",
"title": "لجئون",
"media_type": "Text",
"index_reference": "لجئون",
"language": "arb",
"review_level": "None",
"content": "<p><b>لجئون</b> هو مجموعة كبيرة من الجنود الرومان، أي أكثر من ستة آلاف جندي. وفي المقطع حيث يخبر <a href=\"#t36\">شيطان</a> يسوع أن اسمه &quot;لجئون&quot;، فهو يقصد أن يقول إنه ليس مجرد شيطان واحد، بل إنهم مجموعة كبيرة جدًا من الشياطين.</p>",
"associations": {
"passage": [
{
"start_ref": "40026047",
"start_ref_usfm": "MAT 26:47",
"end_ref": "40026056",
"end_ref_usfm": "MAT 26:56"
},
